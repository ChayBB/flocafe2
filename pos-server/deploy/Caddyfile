# /etc/caddy/Caddyfile — ต้องใช้ Caddy >= 2.7 (repo ทางการ ไม่ใช่ apt ของ Debian ที่เก่ากว่า)
# ใช้ได้ทั้งหลังหรือไม่หลัง Cloudflare:
#   - หลัง Cloudflare: update-cf-ips.sh เขียน trusted_proxies.conf แล้ว Caddy จะเชื่อ CF-Connecting-IP
#     เฉพาะคำขอที่มาจาก IP ของ Cloudflare เท่านั้น (ปลอม header เองไม่ได้)
#   - ไม่ใช้ Cloudflare: ไฟล์ว่าง → Caddy ใช้ IP ของ TCP connection

{
	email ADMIN_EMAIL_PLACEHOLDER

	# ออกใบรับรองเฉพาะ subdomain ของร้านที่มีใน DB (กัน abuse โควตา Let's Encrypt)
	on_demand_tls {
		ask http://127.0.0.1:3001/internal/tls-ask
	}

	servers {
		import /etc/caddy/trusted_proxies.conf
		client_ip_headers CF-Connecting-IP
	}
}

# catch-all: *.BASE_DOMAIN ทุกร้านเข้าตัวนี้ (DNS: wildcard A/AAAA ชี้มาที่เครื่องนี้)
https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# access log: ซ่อน token ของ QR (อยู่ใน path /t/...) และ credential ทุกชนิด
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 7
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "^/(t|j)/[^?]*" "/$1/REDACTED"
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# endpoint ภายในไม่เปิดสู่ภายนอก
	handle /internal/* {
		respond 404
	}

	handle /api/* {
		request_body {
			max_size 128KB
		}
		reverse_proxy 127.0.0.1:3001 127.0.0.1:3002 {
			lb_policy least_conn
			health_uri /healthz
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			# แอปเชื่อ header นี้เพียงตัวเดียวเป็น IP ลูกค้า (ทับค่าที่ client ส่งมาเสมอ)
			header_up X-Real-IP {client_ip}
			# SSE ของ KDS ต้องไม่ถูก buffer
			flush_interval -1
		}
	}

	# หน้าเว็บลูกค้า (SPA) — เสิร์ฟจากดิสก์ ไม่ผ่านแอป
	handle {
		root * /opt/pos/web
		try_files {path} /index.html
		file_server
	}
}

# ให้ HTTP → HTTPS อัตโนมัติ (Caddy ทำให้เองเมื่อมี site แบบ https://)
